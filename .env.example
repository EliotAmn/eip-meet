# --- Database ---
DATABASE_URL="file:./dev.db"

# --- Auth.js / NextAuth (comptes Google + Microsoft, Lot 2) ---
# Secret de session. Générer avec: npx auth secret   (ou: openssl rand -base64 32)
AUTH_SECRET=""
# URL publique de l'app. En local : laisser commenté (déduite de la requête).
# En prod : à renseigner, ex. https://votre-domaine
# AUTH_URL="https://votre-domaine"
# Faire confiance à l'en-tête Host (nécessaire derrière un reverse proxy / en Docker)
AUTH_TRUST_HOST="true"

# Google OAuth  (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type "Web application")
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Microsoft Entra ID / Azure AD  (Azure Portal > App registrations > New registration)
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# "common" = comptes perso + pro. Pour un seul tenant, remplacer "common" par l'ID du tenant.
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/common/v2.0"
