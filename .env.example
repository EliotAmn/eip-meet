# --- Database ---
DATABASE_URL="file:./dev.db"

# --- Auth.js ---
# Secret de session. Générer avec: openssl rand -base64 32
AUTH_SECRET=""
# URL publique de l'app. En local : laisser commenté (déduite de la requête).
# En prod : à renseigner, ex. https://eip-meet.logi-it.com
# AUTH_URL="https://eip-meet.logi-it.com"
# Faire confiance à l'en-tête Host (nécessaire derrière un reverse proxy / en Docker)
AUTH_TRUST_HOST="true"

# --- Microsoft Entra ID (Azure AD) ---
# Callback à déclarer dans l'app registration (plateforme "Web") :
#   https://<domaine>/api/auth/callback/microsoft-entra-id
MICROSOFT_TENANT_ID=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# --- Google OAuth ---
# Callback à déclarer dans le client OAuth "Web application" :
#   https://<domaine>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
