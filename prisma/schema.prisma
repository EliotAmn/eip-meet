generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Accounts (Auth.js Prisma adapter) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  timezone      String? // IANA tz the personal calendar is shown/edited in
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  unavailabilities Unavailability[]
  ownedMeetings    Meeting[]
  memberships      MeetingMember[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  ext_expires_in    Int? // returned by Microsoft Entra ID
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------- Personal long-term calendar ----------

// A (possibly recurring) unavailability, expressed in wall-clock time of its
// own timezone. Occurrences are expanded on demand (src/lib/recurrence.ts).
model Unavailability {
  id        String  @id @default(cuid())
  userId    String
  title     String?
  type      String // "busy" (indisponible) | "soft" (si besoin, à éviter)
  allDay    Boolean @default(false)
  startDate String // YYYY-MM-DD of the first occurrence
  endDate   String // YYYY-MM-DD, last day of an occurrence (== startDate for timed)
  startTime String? // "HH:mm" (timed events)
  endTime   String? // "HH:mm", may be "24:00"
  timezone  String
  freq      String  @default("none") // "none" | "daily" | "weekly" | "monthly"
  interval  Int     @default(1)
  byWeekday String? // weekly: comma-separated ISO weekdays, 1 = Monday .. 7 = Sunday
  until     String? // YYYY-MM-DD, last date an occurrence may start (inclusive)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  exceptions UnavailabilityException[]

  @@index([userId])
}

// One occurrence of a recurring unavailability that was deleted or edited.
model UnavailabilityException {
  id        String  @id @default(cuid())
  eventId   String
  date      String // original occurrence date, YYYY-MM-DD
  cancelled Boolean @default(false)
  title     String?
  type      String?
  startTime String?
  endTime   String?

  event Unavailability @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, date])
}

// ---------- Meetings ----------

model Meeting {
  id          String   @id @default(cuid())
  title       String
  dateMin     String // YYYY-MM-DD (inclusive)
  dateMax     String // YYYY-MM-DD (inclusive)
  granularity Int // slot length in minutes (15 | 30 | 60)
  dayStart    Int // visible window start hour, viewer-local (0-23)
  dayEnd      Int // visible window end hour, viewer-local (1-24)
  ownerId     String
  createdAt   DateTime @default(now())

  owner   User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members MeetingMember[]
  guests  Guest[]
}

// An account invited to a meeting, by email (works before they ever sign in).
model MeetingMember {
  id        String   @id @default(cuid())
  meetingId String
  email     String // lowercased
  userId    String?
  role      String   @default("member") // "admin" | "member"
  createdAt DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([meetingId, email])
}

// Someone without an account, answering through a personal link.
model Guest {
  id        String   @id @default(cuid())
  meetingId String
  name      String
  token     String   @unique @default(cuid())
  timezone  String?
  createdAt DateTime @default(now())

  meeting Meeting     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  slots   GuestSlot[]
}

model GuestSlot {
  id       String @id @default(cuid())
  guestId  String
  startUtc String // ISO-8601 UTC instant of the slot start
  status   String @default("yes") // "yes" | "if_needed"

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([guestId, startUtc])
}
